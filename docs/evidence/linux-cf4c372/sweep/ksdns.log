### ks wireguard: after restore: no leftovers, direct egress back
$ bash -c no_leftovers () 
{ 
    local t l p;
    t=$(sudo nft list tables 2> /dev/null | grep -c 'inet dvpnd');
    l=$(ip -o link | grep -cE ' (dvpn-[a-z0-9-]+|hy2-client|tun[0-9]+)[:@]');
    p=0;
    for pid in $(pgrep -x 'v2ray|xray|hysteria2');
    do
        sudo readlink "/proc/$pid/exe" 2> /dev/null | grep -q '^/usr/local/lib/devnet-dvpn/' && p=$((p + 1));
    done;
    for pid in $(pgrep -x openvpn);
    do
        sudo tr '\0' ' ' < "/proc/$pid/cmdline" 2> /dev/null | grep -q '/var/lib/dvpnd/' && p=$((p + 1));
    done;
    echo "nft=$t links=$l procs=$p egress=$(egress)";
    [ "$t" = 0 ] && [ "$l" = 0 ] && [ "${p:-0}" = 0 ]
}
egress () 
{ 
    curl -s -m 12 https://api.ipify.org
}; for i in 1 2 3 4; do no_leftovers && [ "$(egress)" = '34.123.93.65' ] && exit 0; sleep 5; done; no_leftovers; exit 1
nft=0 links=0 procs=0 egress=34.123.93.65
(exit 0)

