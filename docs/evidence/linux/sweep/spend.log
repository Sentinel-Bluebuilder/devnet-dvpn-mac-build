### final: no leftovers, direct egress
$ bash -c no_leftovers () 
{ 
    local t l p;
    t=$(sudo nft list tables 2> /dev/null | grep -c 'inet dvpnd');
    l=$(ip -o link | grep -cE ' (dvpn-[a-z0-9-]+|hy2-client|tun[0-9]+)[:@]');
    p=$(pgrep -fc '^(/usr/local/lib/devnet-dvpn/[a-z0-9]+/(v2ray|xray|hysteria2) |(/usr/s?bin/)?openvpn .*/var/lib/dvpnd)' || true);
    echo "nft=$t links=$l procs=$p egress=$(egress)";
    [ "$t" = 0 ] && [ "$l" = 0 ] && [ "${p:-0}" = 0 ]
}
egress () 
{ 
    curl -s -m 12 https://api.ipify.org
}; no_leftovers && [ "$(egress)" = '34.123.93.65' ]
nft=0 links=0 procs=0 egress=34.123.93.65
(exit 0)
