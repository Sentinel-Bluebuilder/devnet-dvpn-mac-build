### ks wireguard: egress = node
$ bash -c for i in 1 2 3; do [ "$(curl -s -m 12  https://api.ipify.org)" = '35.232.17.117' ] && exit 0; sleep 3; done; exit 1

(exit 0)

### ks wireguard: nft table inet dvpnd is up
$ bash -c sudo nft list table inet dvpnd >/dev/null

(exit 0)

### ks wireguard: names resolve with the kill switch on
$ bash -c getent hosts example.com >/dev/null || curl -s -m 12  -o /dev/null -w '%{http_code}' https://example.com | grep -q 200

(exit 0)

### ks wireguard: VPN DNS 1.1.1.1 set on dvpn-wg-client
$ bash -c resolvectl dns 'dvpn-wg-client' | grep -q 1.1.1.1

(exit 0)

### ks wireguard: tunnel broken → no direct leak (request fails)
$ bash -c out=$(curl -s -m 10 https://api.ipify.org); [ -z "$out" ] || [ "$out" = '35.232.17.117' ]

(exit 0)

### ks wireguard: tunnel broken → never the direct IP
$ bash -c [ "$(curl -s -m 10 https://api.ipify.org)" != '34.123.93.65' ]

(exit 0)

### ks wireguard: disconnect
$ devnet-dvpn disconnect
Disconnected.
(exit 0)

### ks wireguard: restore network
$ devnet-dvpn daemon restore-network
Network restored.
(exit 0)

### ks wireguard: after restore: no leftovers, direct egress back
$ bash -c no_leftovers () 
{ 
    local t l p;
    t=$(sudo nft list tables 2> /dev/null | grep -c 'inet dvpnd');
    l=$(ip -o link | grep -cE ' (dvpn-[a-z0-9-]+|hy2-client|tun[0-9]+)[:@]');
    p=0;
    for pid in $(pgrep -x 'v2ray|xray|hysteria2');
    do
        sudo readlink "/proc/$pid/exe" 2> /dev/null | grep -q '^/usr/local/lib/devnet-dvpn/' && p=$((p + 1));
    done;
    for pid in $(pgrep -x openvpn);
    do
        sudo tr '\0' ' ' < "/proc/$pid/cmdline" 2> /dev/null | grep -q '/var/lib/dvpnd/' && p=$((p + 1));
    done;
    echo "nft=$t links=$l procs=$p egress=$(egress)";
    [ "$t" = 0 ] && [ "$l" = 0 ] && [ "${p:-0}" = 0 ]
}
egress () 
{ 
    curl -s -m 12 https://api.ipify.org
}; for i in 1 2 3 4; do no_leftovers && [ "$(egress)" = '34.123.93.65' ] && exit 0; sleep 5; done; no_leftovers; exit 1
nft=0 links=0 procs=0 egress=34.123.93.65
(exit 0)

